# 复制本文件为 .env 后填写真实值（.env 已加入 .gitignore，不要提交）

# 模型提供方：deepseek | dashscope | ollama（本地）
# 也可用命令行临时覆盖：uv run python main.py deepseek "你的问题"
MODEL_PROVIDER=deepseek

# ---- DeepSeek 官网 API（OpenAI 兼容）----
# 控制台：https://platform.deepseek.com/api_keys
# 可用模型：deepseek-chat（V3，工具调用稳） | deepseek-reasoner（会先输出思维链）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ---- 阿里云百炼（通义千问）----
# 控制台：https://bailian.console.aliyun.com/  → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_MODEL=qwen-plus
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 本地 Ollama ----
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://127.0.0.1:11434

# 旧 quickstart 示例循环控制；Office Agent 默认不限制模型决策次数。
# 需要人为设上限时可设置 OFFICE_DECISION_LIMIT=1..64；0 表示不限制。
RECURSION_LIMIT=25
OFFICE_DECISION_LIMIT=0
# Office Agent 的模型上下文容量、回复预算通过配置给出；模型名读取上方 *_MODEL
# 必须设置为你的模型真实支持的窗口，不要为了"够用"写超过模型上限的值。
# 实测固定开销（25 个工具全开 + 768 回复预算）约 6400 token：工具描述会进入
# 每一次模型调用，窗口过小会让描述本身吃掉大部分可用空间，任务更容易触发压缩或
# 预算停止。deepseek-chat(64k) / qwen-plus(32k) / 本地 qwen2.5:7b(32k) 均支持 32k，
# 故示例给 32768；本地小窗口模型（如 8k）请务必调低，否则会超出模型真实窗口。
OFFICE_CONTEXT_WINDOW=32768
OFFICE_REPLY_BUDGET=768

# ---- Web UI 启动（不设置时 Windows 默认 Edge/netfx，其他平台 Qt）----
# 显式进程环境优先；模型配置仍沿用上面的提供方设置。
# OFFICE_WEBVIEW_GUI=edgechromium
# PYTHONNET_RUNTIME=netfx
# Windows 标准 Start-OfficeAgent.cmd 固定使用已验证的隔离 Edge/netfx 组合。

# ---- 图片理解（与生图无关；仅点击界面分析并确认后发送）----
# 使用 DEEPSEEK_API_KEY；模型须支持图片输入，例如官方文档列出的 deepseek-flash。
# 留空则拒绝发送；图片内容不写回文档，也不进入普通任务历史。
OFFICE_VISION_MODEL=

# ---- 图片 P3 独立配置（已接通计划与 Web 独立确认；绝不自动请求）----
# 不复用聊天密钥；请按图片服务文档填写真实 HTTPS 地址与模型，不提供默认模型。
# BASE_URL / MODEL / KEY 留空时不可生成；生成可能收费，确认生成与确认保存是两次独立操作。
IMAGE_PROVIDER=openai_compatible
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=
# auto 不发送 response_format；仅接受单张内联 b64_json，绝不下载返回 URL。
# 确认兼容服务支持该字段时可改为 b64_json；不自动重试或更换参数重发。
IMAGE_RESPONSE_FORMAT=auto
# 每次 I/O 超时上限 60 秒；响应头/分块间另检查单调时间，不是进程硬总超时。
IMAGE_TIMEOUT=60

# ---- 可选：知识检索 embedding（未设置时拒绝索引，不会自动下载模型）----
# api：显式选择 text-embedding-v3/v4，使用上方 DASHSCOPE_API_KEY/BASE_URL。
# local：MODEL 填写已准备的绝对离线模型目录；仅 safetensors，不加载自定义Python/ pickle。
# 本地依赖显式安装：uv sync --extra local-embedding；这不会下载模型权重。
OFFICE_EMBEDDING_CHANNEL=local
OFFICE_EMBEDDING_MODEL=
OFFICE_EMBEDDING_DIMENSION=
OFFICE_EMBEDDING_TIMEOUT=20
# 每次请求/模型运算边界检查总预算；无法中断已进入的同步本地加载/encode。
OFFICE_EMBEDDING_BUDGET=30

# ---- 可选：MCP 相关（写进 .env，别硬编码）----
AMAP_MAPS_API_KEY=
GITHUB_PERSONAL_ACCESS_TOKEN=

OFFICE_RERANKER_MODEL=
OFFICE_RERANKER_TIMEOUT=8
OPENALEX_API_KEY=
OFFICE_LITERATURE_KEY_REQUESTS=0
OFFICE_LITERATURE_TIMEOUT=8
OFFICE_LITERATURE_REQUEST_LIMIT=20
OFFICE_CHAT_HISTORY=false
OFFICE_CHAT_REPLY_TOKENS=512
OFFICE_IMAGE_REUSE_METADATA=false
